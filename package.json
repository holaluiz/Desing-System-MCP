{
  "name": "@caramelo/design-system",
  "version": "2.0.0",
  "description": "Sistema de Design Canônico V2 2026 & Servidor MCP de UX/UI — transforma qualquer interface na identidade Um Cara Caramelo (Laboratório de Interação)",
  "author": "Luiz | Head de Interação <umcaracaramelo>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "caramelo-design-system-mcp": "./dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.mjs",
      "require": "./dist/tailwind/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.mjs",
      "require": "./dist/motion/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.mjs",
      "require": "./dist/engine/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.mjs",
      "require": "./dist/mcp/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "import": "./dist/brand/index.mjs",
      "require": "./dist/brand/index.js"
    },
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "src/tokens/tokens.json"
  ],
  "scripts": {
    "build": "tsup",
    "assets:sync": "node scripts/sync-brand-assets.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "mcp": "node dist/mcp/index.js",
    "showcase": "npm --prefix apps/showcase run dev",
    "showcase:build": "npm --prefix apps/showcase run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "lenis": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lenis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "lenis": "^1.1.18",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
